														"end_time": {
															"value": {
																"value": "@activity('Copy_SQL_Incremental_Load').ExecutionEndTime",
																"type": "Expression"
															},
															"type": "DateTime"
														},
														"error_message": {
															"value": null,
															"type": "String"
