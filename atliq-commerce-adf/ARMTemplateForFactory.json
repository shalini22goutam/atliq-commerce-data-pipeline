{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "atliq-commerce-adf"
		},
		"LS_storage_account_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_storage_account'"
		},
		"LS_azure_databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0818-034717-qk7hyzdn"
		},
		"LS_key_vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://atliqcommerce.vault.azure.net/"
		},
		"LS_sql_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "atliq-sql-server.database.windows.net"
		},
		"LS_sql_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "atliq_commerce"
		},
		"LS_sql_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "atliq_admin"
		},
		"LS_storage_account_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://atliqcommerce.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/atliq_commerce_ingestion')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "This pipeline copies raw data from Azure SQL database tables and copies to bronze container of ADLS gen2 storage account",
				"activities": [
					{
						"name": "Set_Run_Start_At",
						"description": "It captures the start time of the pipeline.",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "run_start_at",
							"value": {
								"value": "@utcNow()",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Lookup_Control_Table",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "Set_Run_Start_At",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT\n    source_schema,\n    table_name,\n    load_type,\n    watermark_column,\n    last_loaded_at\nFROM etl.control_table;\n",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_Control_Table",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach_Control_Table",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup_Control_Table",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_Control_Table').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "If_Load_Type",
									"type": "IfCondition",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@equals(item().load_type, 'incremental')",
											"type": "Expression"
										},
										"ifFalseActivities": [
											{
												"name": "Copy_SQL_Full_Load",
												"description": "It copies the data for full load type.",
												"type": "Copy",
												"dependsOn": [
													{
														"activity": "Delete_Full_Load",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "AzureSqlSource",
														"sqlReaderQuery": {
															"value": "SELECT *\nFROM [@{item().source_schema}].[@{item().table_name}]",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "ParquetSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "ParquetWriteSettings"
														}
													},
													"enableStaging": false,
													"translator": {
														"type": "TabularTranslator",
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "DS_SQL_Source",
														"type": "DatasetReference",
														"parameters": {
															"schema": {
																"value": "@item().source_schema",
																"type": "Expression"
															},
															"table_name": {
																"value": "@item().table_name",
																"type": "Expression"
															}
														}
													}
												],
												"outputs": [
													{
														"referenceName": "DS_ADLS_Bronze",
														"type": "DatasetReference",
														"parameters": {
															"table_name": {
																"value": "@item().table_name",
																"type": "Expression"
															}
														}
													}
												]
											},
											{
												"name": "Update_Watermark_Full",
												"description": "It updates the watermark column for full load.",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "Copy_SQL_Full_Load",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[etl].[usp_update_watermark]",
													"storedProcedureParameters": {
														"table_name": {
															"value": {
																"value": "@item().table_name",
																"type": "Expression"
															}
														},
														"run_start_at": {
															"value": {
																"value": "@variables('run_start_at')",
																"type": "Expression"
															}
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_sql_db",
													"type": "LinkedServiceReference"
												}
											},
											{
												"name": "Delete_Full_Load",
												"description": "It deletes the folder of full load type tables.",
												"type": "Delete",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"dataset": {
														"referenceName": "DS_ADLS_Bronze",
														"type": "DatasetReference",
														"parameters": {
															"table_name": {
																"value": "@item().table_name",
																"type": "Expression"
															}
														}
													},
													"enableLogging": false,
													"storeSettings": {
														"type": "AzureBlobFSReadSettings",
														"recursive": true,
														"enablePartitionDiscovery": false
													}
												}
											},
											{
												"name": "Copy_FullLoad_Audit_Success",
												"description": "This activity logs failure event post copy activity.",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "Copy_SQL_Full_Load",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[etl].[usp_log_adf_activity]",
													"storedProcedureParameters": {
														"activity_name": {
															"value": "Copy_SQL_Full_Load",
															"type": "String"
														},
														"end_time": {
															"value": {
																"value": "@activity('Copy_SQL_Full_Load').ExecutionEndTime",
																"type": "Expression"
															},
															"type": "DateTime"
														},
														"error_message": {
															"value": null,
															"type": "String"
														},
														"layer": {
															"value": "Bronze",
															"type": "String"
														},
														"load_type": {
															"value": "Full",
															"type": "String"
														},
														"pipeline_run_id": {
															"value": {
																"value": "@pipeline().RunId",
																"type": "Expression"
															},
															"type": "String"
														},
														"row_count": {
															"value": {
																"value": "@activity('Copy_SQL_Full_Load').output.rowsCopied",
																"type": "Expression"
															},
															"type": "Int64"
														},
														"source_name": {
															"value": {
																"value": "@concat(item().source_schema, '.', item().table_name)",
																"type": "Expression"
															},
															"type": "String"
														},
														"start_time": {
															"value": {
																"value": "@activity('Copy_SQL_Full_Load').ExecutionStartTime",
																"type": "Expression"
															},
															"type": "DateTime"
														},
														"status": {
															"value": "Success",
															"type": "String"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_sql_db",
													"type": "LinkedServiceReference"
												}
											},
											{
												"name": "Copy_FullLoad_Audit_Fail",
												"description": "This activity logs failure event post copy activity.",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "Copy_SQL_Full_Load",
														"dependencyConditions": [
															"Failed"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[etl].[usp_log_adf_activity]",
													"storedProcedureParameters": {
														"activity_name": {
															"value": "Copy_SQL_Full_Load",
															"type": "String"
														},
														"end_time": {
															"value": {
																"value": "@activity('Copy_SQL_Full_Load').ExecutionEndTime",
																"type": "Expression"
															},
															"type": "DateTime"
														},
														"error_message": {
															"value": {
																"value": "@activity('Copy_SQL_Full_Load').output.errors\n",
																"type": "Expression"
															},
															"type": "String"
														},
														"layer": {
															"value": "Bronze",
															"type": "String"
														},
														"load_type": {
															"value": "Full",
															"type": "String"
														},
														"pipeline_run_id": {
															"value": {
																"value": "@pipeline().RunId",
																"type": "Expression"
															},
															"type": "String"
														},
														"row_count": {
															"value": null,
															"type": "Int64"
														},
														"source_name": {
															"value": {
																"value": "@concat(item().source_schema, '.', item().table_name)",
																"type": "Expression"
															},
															"type": "String"
														},
														"start_time": {
															"value": {
																"value": "@activity('Copy_SQL_Full_Load').ExecutionStartTime",
																"type": "Expression"
															},
															"type": "DateTime"
														},
														"status": {
															"value": "Fail",
															"type": "String"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_sql_db",
													"type": "LinkedServiceReference"
												}
											}
										],
										"ifTrueActivities": [
											{
												"name": "Copy_SQL_Incremental_Load",
												"description": "It copies data in incremental batches.",
												"type": "Copy",
												"dependsOn": [
													{
														"activity": "Delete_Incremental_Folder",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "AzureSqlSource",
														"sqlReaderQuery": {
															"value": "SELECT *\nFROM [@{item().source_schema}].[@{item().table_name}]\nWHERE [@{item().watermark_column}] > '@{item().last_loaded_at}';",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "ParquetSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "ParquetWriteSettings"
														}
													},
													"enableStaging": false,
													"translator": {
														"type": "TabularTranslator",
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "DS_SQL_Source",
														"type": "DatasetReference",
														"parameters": {
															"schema": {
																"value": "@item().source_schema\n",
																"type": "Expression"
															},
															"table_name": {
																"value": "@item().table_name",
																"type": "Expression"
															}
														}
													}
												],
												"outputs": [
													{
														"referenceName": "DS_ADLS_Bronze",
														"type": "DatasetReference",
														"parameters": {
															"table_name": {
																"value": "@concat(\n    item().table_name,\n    '/ingest_date=',\n    formatDateTime(variables('run_start_at'),'yyyy-MM-dd')\n)",
																"type": "Expression"
															}
														}
													}
												]
											},
											{
												"name": "Update_Watermark_Incremental",
												"description": "It updates the watermark for incremental load in control table.",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "Copy_SQL_Incremental_Load",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[etl].[usp_update_watermark]",
													"storedProcedureParameters": {
														"table_name": {
															"value": {
																"value": "@item().table_name",
																"type": "Expression"
															},
															"type": "String"
														},
														"run_start_at": {
															"value": {
																"value": "@variables('run_start_at')",
																"type": "Expression"
															},
															"type": "Datetime"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_sql_db",
													"type": "LinkedServiceReference"
												}
											},
											{
												"name": "Delete_Incremental_Folder",
												"description": "It deletes the folder for particular day to eliminate duplicate as part of retry activity.",
												"type": "Delete",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"dataset": {
														"referenceName": "DS_ADLS_Bronze",
														"type": "DatasetReference",
														"parameters": {
															"table_name": {
																"value": "@concat(\n    item().table_name,\n    '/ingest_date=',\n    formatDateTime(variables('run_start_at'),'yyyy-MM-dd')\n)",
																"type": "Expression"
															}
														}
													},
													"logStorageSettings": {
														"linkedServiceName": {
															"referenceName": "LS_storage_account",
															"type": "LinkedServiceReference"
														},
														"path": "raw"
													},
													"enableLogging": true,
													"storeSettings": {
														"type": "AzureBlobFSReadSettings",
														"recursive": true,
														"enablePartitionDiscovery": false
													}
												}
											},
											{
												"name": "Copy_Incremental_Audit_Fail",
												"description": "This activity logs failure event post copy activity.",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "Copy_SQL_Incremental_Load",
														"dependencyConditions": [
															"Failed"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[etl].[usp_log_adf_activity]",
													"storedProcedureParameters": {
														"activity_name": {
															"value": "Copy_SQL_Incremental_Load",
															"type": "String"
														},
														"end_time": {
															"value": {
																"value": "@activity('Copy_SQL_Incremental_Load').ExecutionEndTime",
																"type": "Expression"
															},
															"type": "DateTime"
														},
														"error_message": {
															"value": {
																"value": "@activity('Copy_SQL_Incremental_Load').output.errors",
																"type": "Expression"
															},
															"type": "String"
														},
														"layer": {
															"value": "Bronze",
															"type": "String"
														},
														"load_type": {
															"value": "Incremental",
															"type": "String"
														},
														"pipeline_run_id": {
															"value": {
																"value": "@pipeline().RunId",
																"type": "Expression"
															},
															"type": "String"
														},
														"row_count": {
															"value": null,
															"type": "Int64"
														},
														"source_name": {
															"value": {
																"value": "@concat(item().source_schema, '.', item().table_name)",
																"type": "Expression"
															},
															"type": "String"
														},
														"start_time": {
															"value": {
																"value": "@activity('Copy_SQL_Incremental_Load').ExecutionStartTime",
																"type": "Expression"
															},
															"type": "DateTime"
														},
														"status": {
															"value": "Fail",
															"type": "String"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_sql_db",
													"type": "LinkedServiceReference"
												}
											},
											{
												"name": "Copy_Incremental_Audit_Success",
												"description": "This activity logs failure event post copy activity.",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "Copy_SQL_Incremental_Load",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[etl].[usp_log_adf_activity]",
													"storedProcedureParameters": {
														"activity_name": {
															"value": "Copy_SQL_Incremental_Load",
															"type": "String"
