{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "atliq-commerce-adf"
		},
		"LS_storage_account_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_storage_account'"
		},
		"LS_azure_databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0818-034717-qk7hyzdn"
		},
		"LS_key_vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://atliqcommerce.vault.azure.net/"
		},
		"LS_sql_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "atliq-sql-server.database.windows.net"
		},
		"LS_sql_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "atliq_commerce"
		},
		"LS_sql_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "atliq_admin"
		},
		"LS_storage_account_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://atliqcommerce.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "atliq-commerce-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_storage_account_accountKey": {
						"value": "[parameters('LS_storage_account_accountKey')]"
					},
					"LS_key_vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_key_vault_properties_typeProperties_baseUrl')]"
					},
					"LS_storage_account_properties_typeProperties_url": {
						"value": "[parameters('LS_storage_account_properties_typeProperties_url')]"
					},
					"LS_azure_databricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_azure_databricks_properties_typeProperties_existingClusterId')]"
					},
					"LS_sql_db_properties_typeProperties_server": {
						"value": "[parameters('LS_sql_db_properties_typeProperties_server')]"
					},
					"LS_sql_db_properties_typeProperties_database": {
						"value": "[parameters('LS_sql_db_properties_typeProperties_database')]"
					},
					"LS_sql_db_properties_typeProperties_userName": {
						"value": "[parameters('LS_sql_db_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}