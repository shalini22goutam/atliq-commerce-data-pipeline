5Z"}, {"name": "execute", "started_at": "2026-08-19T11:55:39.301384Z", "completed_at": "2026-08-19T11:55:51.348983Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 12.22021484375, "adapter_response": {"_message": "OK", "query_id": "01f19bc4-ea13-17aa-a84d-2a88dcccf2cc"}, "message": "OK", "failures": null, "unique_id": "model.atliq_gold_dbt.fact_sales", "compiled": true, "compiled_code": "with __dbt__cte__stg_order_items as (\nSELECT \n    order_item_id, \n    order_id, \n    product_id, \n    quantity,\n    item_price\nFROM `atliq`.`silver`.`order_items`\n),  __dbt__cte__stg_orders as (\n-- models/staging/stg_orders.sql\nSELECT \n    order_id, \n    customer_id, \n    order_date, \n    status, \n    order_amount\nFROM \n    `atliq`.`silver`.`orders`\n) -- models/gold/fact_sales.sql\n-- Grain: one row per order item\n\n\n\n\n\n-- Grain: one row per order item\n\nSELECT\n    oi.order_item_id,\n    o.order_id,\n    o.customer_id,\n    oi.product_id,\n    o.order_date,\n    oi.quantity,\n    oi.item_price,\n    oi.quantity * oi.item_price AS gross_revenue,\n    o.status\n\nFROM __dbt__cte__stg_order_items AS oi\n\nINNER JOIN __dbt__cte__stg_orders AS o\n    ON oi.order_id = o.order_id\n\n\n\nWHERE oi.order_item_id > (\n    SELECT COALESCE(MAX(order_item_id), 0)\n    FROM `atliq`.`gold`.`fact_sales`\n)\n\n", "relation_name": "`atliq`.`gold`.`fact_sales`", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-19T11:55:51.542838Z", "completed_at": "2026-08-19T11:55:51.557295Z"}, {"name": "execute", "started_at": "2026-08-19T11:55:51.559320Z", "completed_at": "2026-08-19T11:55:52.608740Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 1.3793270587921143, "adapter_response": {"_message": "OK", "query_id": "01f19bc4-ed2e-15ae-b804-029524f3c4ae"}, "message": null, "failures": 0, "unique_id": "test.atliq_gold_dbt.unique_fact_sales_order_item_id.4f7c479761", "compiled": true, "compiled_code": "\