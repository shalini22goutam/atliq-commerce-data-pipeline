) -- models/gold/dim_product.sql

SELECT
    p.product_id,
    p.product_name,
    p.category,
    p.unit_price,
    s.supplier_cost,
    (p.unit_price - s.supplier_cost) AS unit_margin

FROM __dbt__cte__stg_products AS p

LEFT JOIN __dbt__cte__stg_supplier_price_list AS s
    ON p.product_id = s.product_id
  
