    kcu.column_name AS from_column,
    ukcu.table_catalog AS to_catalog,
    ukcu.table_schema AS to_schema,
    ukcu.table_name AS to_table,
    ukcu.column_name AS to_column
  FROM `atliq`.information_schema.key_column_usage kcu
  JOIN `atliq`.information_schema.referential_constraints rc
    ON kcu.constraint_name = rc.constraint_name
  JOIN `atliq`.information_schema.key_column_usage ukcu
    ON rc.unique_constraint_name = ukcu.constraint_name
    AND kcu.ordinal_position = ukcu.ordinal_position
  WHERE kcu.table_catalog = 'atliq'
    AND kcu.table_schema = 'gold'
    AND kcu.table_name = 'fact_sales'
    AND kcu.constraint_name IN (
      SELECT constraint_name
      FROM `atliq`.information_schema.table_constraints
      WHERE table_catalog = 'atliq'
        AND table_schema = 'gold'
        AND table_name = 'fact_sales'
        AND constraint_type = 'FOREIGN KEY'
    )
  ORDER BY kcu.ordinal_position;
  
