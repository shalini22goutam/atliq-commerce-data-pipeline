table fact_sales
	lineageTag: d51123db-a891-4999-8a93-0cec34cf882e
	sourceLineageTag: [gold].[fact_sales]

	measure net_revenue = [gross_revenue]-[returned_revenue]
		lineageTag: 4bf9c082-5765-4c8b-b0b5-81bfd893c282

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure gross_revenue =
			
			CALCULATE(
			    SUM(fact_sales[revenue]),
			    KEEPFILTERS(fact_sales[status] <> "Cancelled")
			)
		lineageTag: fdffd25c-02ee-4805-8f9a-32eae83c2d7e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure returned_revenue =
			
			CALCULATE(
			    SUM(fact_sales[revenue]),
			    KEEPFILTERS(fact_sales[status] = "Returned")
			)
		lineageTag: 712df4f7-cea1-4a5f-a143-d07813584151

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Customers = DISTINCTCOUNT(fact_sales[customer_id])
		formatString: 0
		lineageTag: 4c6e91dd-253d-4478-9c10-79e38178da57

		changedProperty = Name

